{
  "name": "ui-lib",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "homepage": "https://ui-lib.quebi.de",
  "scripts": {
    "predev": "bun run generate:api",
    "dev": "react-router dev",
    "generate:api": "bun run scripts/generate-api.ts",
    "generate:lint": "bun run scripts/generate-lint-config.ts",
    "test": "bun test",
    "build": "bun run generate:api && react-router build && bun run screenshot:og",
    "screenshot:og": "bun run scripts/screenshot-og.ts",
    "start": "react-router-serve ./build/server/index.js",
    "preview": "vite preview",
    "typecheck": "bun run generate:api && react-router typegen && tsc -b",
    "repo:config": "bun run scripts/repo-config.ts",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "prepare": "lefthook install || echo 'lefthook: pre-commit hook not installed. A global core.hooksPath is set, so git ignores .git/hooks and there is nowhere for lefthook to write. Nothing is broken: the hook is a convenience and CI runs the same lint, which you can also run by hand with bun run lint. To have it anyway, scope it to this repo with: git config --local core.hooksPath .git/hooks && bunx lefthook install. Do not reach for --force, which installs into the global hooks path itself, where the hook then runs for every repo on the machine and can overwrite hooks that something else manages.'"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@conform-to/react": "^1.21.1",
    "@conform-to/valibot": "^1.21.1",
    "@internationalized/date": "^3.12.2",
    "@tanstack/react-table": "^9.2.4",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.460.0",
    "motion": "^12.42.2",
    "overlayscrollbars": "^2.16.0",
    "react": "^19.0.0",
    "react-aria": "^3.50.0",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.0.0",
    "react-router": "^8",
    "react-stately": "^3.48.0",
    "recharts": "^3.9.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss-react-aria-components": "^2.2.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@happy-dom/global-registrator": "^20.14.0",
    "@react-router/dev": "^8.1.0",
    "@react-router/fs-routes": "^8.1.0",
    "@react-router/node": "^8.1.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lefthook": "^2.1.12",
    "playwright": "^1.63.0",
    "shiki": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
