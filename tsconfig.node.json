{
  "compilerOptions": {
    "target": "ES2022",
    // `scripts/og-audit.ts` measures the share images from inside Chromium:
    // its measurement function is serialized by Playwright and runs in the page,
    // so it is browser code living in a Node script and needs the DOM types.
    "lib": ["ES2023", "DOM"],
    "types": ["bun", "node"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["vite.config.ts", "react-router.config.ts", "scripts"]
}
