// Gate lastResult on an idle navigation
// AUTO-GENERATED from https://ui-lib.quebi.de/api/rules/gate-last-result-on-idle-navigation.json — do not edit by hand.
//
// https://ui-lib.quebi.de/rules/gate-last-result-on-idle-navigation
//
// This file says what the rule is, not where it applies. A plugin listed in
// the top-level `plugins` runs against every file Biome lints, so scope it
// with an `overrides` entry — Biome resolves `includes` against the project
// root, which is the one thing a $filename regex in here could not do:
//
//   {
//     "overrides": [
//       {
//         "includes": [
//           "app/**/*.{tsx,jsx}",
//           "src/**/*.{tsx,jsx}",
//           "!**/*.stories.{tsx,jsx}",
//           "!**/*.examples.{tsx,jsx}"
//         ],
//         "plugins": [
//           "./ui-lib-rules/gate-last-result-on-idle-navigation.grit"
//         ]
//       }
//     ]
//   }

language js;

JsCallExpression(
  callee = `useForm`,
  arguments = JsCallArguments(args = [$options])
) as $call where {
  $options <: JsObjectExpression(),
  $options <: contains bubble or {
    JsPropertyObjectMember(name = $name, value = $value) where {
      $name <: `lastResult`,
      $value <: not contains `navigation.state`,
      $value <: not contains `fetcher.state`
    },
    JsShorthandPropertyObjectMember(name = $name) where { $name <: `lastResult` }
  },
  register_diagnostic(
    span = $call,
    message = "lastResult is applied on every render, so an ungated one lands before React Router has revalidated the loader data behind the form — a form with loader defaults snaps back to its previous value after a reset. Pass lastResult: navigation.state === 'idle' ? lastResult : null (or fetcher.state for a fetcher). See https://ui-lib.quebi.de/rules/gate-last-result-on-idle-navigation",
    severity = "error"
  )
}
