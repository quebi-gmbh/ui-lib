{
  // The solution file does not compile anything itself, but `bun test` reads
  // path aliases from the root tsconfig — and tests/conform-binding.test.tsx
  // imports components that resolve `@/lib/utils`. The per-project configs
  // repeat this; it is not inherited from here.
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "./tsconfig.test.json"
    }
  ]
}
